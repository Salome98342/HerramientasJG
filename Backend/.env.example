# Desarrollo local (copiar a .env y completar SECRET_KEY/DATABASE_URL)
SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/herramientas_jg
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
AUTH_REFRESH_COOKIE=jg_refresh
AUTH_COOKIE_SAMESITE=Lax
AUTH_REFRESH_COOKIE_SECURE=False
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15
AUTH_LOGIN_THROTTLE=5/minute
AUTH_REFRESH_THROTTLE=30/minute
AUTH_ACCESS_TOKEN_MINUTES=12
AUTH_REFRESH_TOKEN_DAYS=7

# Producción (descomentar/configurar solo detrás de HTTPS)
# DEBUG=False
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# AUTH_REFRESH_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# CORS_ALLOWED_ORIGINS=https://app.example.com
# CSRF_TRUSTED_ORIGINS=https://app.example.com
